{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    u.full_name,\n    u.email,\n    COUNT(n.uuid) AS \"unread!\",\n    MIN(n.created_at) AS \"oldest_unread!\"\nFROM \"user\" AS u\nINNER JOIN notification AS n ON u.uuid = n.recipient_uuid\nWHERE\n    n.read_at IS NULL\n    AND u.uuid IN (\n        SELECT DISTINCT user_uuid FROM course_member\n        WHERE status = 'active'\n    )\nGROUP BY u.uuid\nORDER BY COUNT(n.uuid) DESC\n",
